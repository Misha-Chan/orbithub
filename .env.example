# ============================================================
# orbithub — نموذج متغيرات البيئة
# انسخه إلى .env ثم عدّل القيم: cp .env.example .env
# لا ترفع ملف .env إلى المستودع أبداً.
# ============================================================

# قاعدة بيانات Turso (libSQL). للتجربة المحلية يمكن استخدام ملف:
#   TURSO_DATABASE_URL=file:./local.db
# وفي هذه الحالة اترك TURSO_AUTH_TOKEN فارغاً.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# (اختياري) عنوان خدمة Hostaka الأساسية للتحقق من الجلسة.
# الافتراضي: https://hostaka.fun
HOSTAKA_BASE_URL=https://hostaka.fun

# (اختياري) مفتاح ImgBB لرفع الصور — بدونه رفع الصور يرجع خطأ واضح.
IMGBB_API_KEY=

# (اختياري) منفذ التشغيل المحلي (الافتراضي 3000).
PORT=3000

# (اختياري) حدّ الطلبات لكل دقيقة لكل IP على /api (الافتراضي 240).
RATE_LIMIT_MAX=240
