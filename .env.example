# عنوان السيرفر الرئيسي لهوستاكا — كل طلبات /api/* بهذا المستودع تُمرَّر
# (proxy) إليه. القيمة الافتراضية بالكود لو ما ضبطت هذا المتغير هي
# https://hostaka.fun، فهو اختياري عملياً إلا إذا احتجت تشاور على نطاق
# مختلف (بيئة staging مثلاً).
HOSTAKA_API_BASE=https://hostaka.fun

# منفذ التشغيل المحلي فقط (Vercel يتجاهل هذا ويدير المنفذ لحاله)
PORT=3000
